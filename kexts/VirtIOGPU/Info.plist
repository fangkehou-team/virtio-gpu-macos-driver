<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key><string>English</string>
	<key>CFBundleExecutable</key><string>VirtIOGPU</string>
	<key>CFBundleIdentifier</key><string>io.vmtl.VirtIOGPU</string>
	<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
	<key>CFBundleName</key><string>VirtIOGPU</string>
	<key>CFBundlePackageType</key><string>KEXT</string>
	<key>CFBundleShortVersionString</key><string>0.1</string>
	<key>CFBundleVersion</key><string>0.1</string>
	<key>IOUserClientClass</key><string>VirtIOGPUUserClient</string>
	<key>OSBundleLibraries</key>
	<dict>
		<key>com.apple.kpi.iokit</key><string>8.0</string>
		<key>com.apple.kpi.libkern</key><string>8.0</string>
		<key>com.apple.kpi.mach</key><string>8.0</string>
		<key>com.apple.kpi.bsd</key><string>8.0</string>
		<key>com.apple.iokit.IOPCIFamily</key><string>1.0.0b1</string>
		<key>com.apple.iokit.IOGraphicsFamily</key><string>1.0.0</string>
	</dict>
	<key>IOKitPersonalities</key>
	<dict>
		<key>VirtIOGPU</key>
		<dict>
			<key>CFBundleIdentifier</key><string>io.vmtl.VirtIOGPU</string>
			<key>IOClass</key><string>VirtIOGPU</string>
			<key>IOProviderClass</key><string>IOPCIDevice</string>
			<key>IOUserClientClass</key><string>VirtIOGPUUserClient</string>
			<!-- virtio-gpu modern PCI device. IOPCIPrimaryMatch compares the 32-bit
			     (device<<16 | vendor) word (same encoding NVRM uses for 0x10de), so
			     0x00001af4&0x0000ffff reads as "vendor 0x1af4 (Red Hat/virtio), any
			     device"; the probe() gate then accepts only device 0x1050 (virtio-gpu)
			     with revision >= 1 (virtio 1.0). The legacy/transitional 0x0010 with
			     revision 0 is deliberately not matched: this driver speaks only the
			     modern common-config layout. IOPCIClassMatch pins the PCI base class to
			     0x03 (display) and leaves the subclass free, so both VGA (0x00) and 3D
			     controller (0x02) match - like NVRM.kext's mask, wide ON PURPOSE. -->
			<key>IOPCIPrimaryMatch</key>
			<string>0x00001af4&amp;0x0000ffff</string>
			<key>IOPCIClassMatch</key>
			<string>0x03000000&amp;0xff000000</string>
			<key>IOProbeScore</key>
			<!-- must beat AppleVirtIOPCITransport, whose generic 1af4 personality
			     scores 10000 and would otherwise claim the GPU device too -->
			<integer>20000</integer>
			<!-- Own match category, NOT the default one. AppleVirtIO sits in the
			     BootKC, so its generic 1af4 transport personality claims the GPU
			     at PCI scan (IOMatchedAtBoot), long before the aux KC delivers
			     this personality. XNU's passiveMatch then skips ours every pass:
			     the default category is occupied and the transport has no
			     IOPrimaryDriverTerminateOptions property, so no replacement is
			     allowed (IOService.cpp: categoryConsumed -> break). A distinct
			     category attaches alongside it, exactly like Apple's own
			     IONDRVFramebuffer does on the same nub with category
			     "IOFramebuffer". start() re-resets the device anyway. -->
			<key>IOMatchCategory</key>
			<string>VirtIOGPU</string>
		</dict>
		<key>VirtIOFB</key>
		<dict>
			<key>CFBundleIdentifier</key><string>io.vmtl.VirtIOGPU</string>
			<key>IOClass</key><string>VirtIOFB</string>
			<key>IOProviderClass</key><string>VirtIOGPU</string>
			<!-- one framebuffer candidate per controller: without this category the
			     firmware IONDRVFramebuffer also matches and two consoles fight -->
			<key>IOMatchCategory</key><string>IOFramebuffer</string>
			<key>IOProbeScore</key><integer>60000</integer>
		</dict>
	</dict>
</dict>
</plist>
